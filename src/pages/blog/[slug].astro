---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import { posts, type Post, type PostBlock } from '../../data/posts';
import '../../styles/article.css';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: Post };

const fallbackContent: PostBlock[] = [
  { type: 'paragraph', text: 'Strategi yang baik hanya bernilai ketika setiap orang memahami langkah berikutnya. Karena itu, mulailah dengan menyederhanakan tujuan menjadi keputusan dan kebiasaan kerja yang bisa dilakukan tim setiap minggu.' },
  { type: 'heading', text: 'Mulai dari konteks yang sama' },
  { type: 'paragraph', text: 'Pastikan tim mengetahui mengapa pekerjaan ini penting, hasil apa yang ingin dicapai, dan bagaimana progresnya akan terlihat. Kejelasan ini membantu prioritas tetap kuat ketika pekerjaan harian mulai ramai.' },
  { type: 'heading', text: 'Jadikan progres mudah dilihat' },
  { type: 'paragraph', text: 'Ritme review singkat dan indikator yang relevan akan membuat hambatan muncul lebih awal. Bukan untuk mengawasi setiap langkah, tetapi agar tim dapat saling membantu sebelum target meleset.' },
  { type: 'paragraph', text: 'Dengan sistem yang menyambungkan arah dan eksekusi, percakapan tim dapat kembali berfokus pada dampak.' },
];

const content = post.content ?? fallbackContent;
---

<BaseLayout title={`${post.title} — Blog Sprintime`} description={post.excerpt}>
  <div class="scroll-progress" aria-hidden="true"><span></span></div>
  <SiteHeader active="blog" />
  <main class="article-page">
    <article>
      <p class="post-meta"><span>{post.category}</span>{post.date} · {post.readTime}</p>
      <h1>{post.title}</h1>
      <p class="article-lede">{post.excerpt}</p>
      <img class="article-image" src={post.image} alt={post.imageAlt} />
      <div class="article-content">
        {content.map((block) => (
          block.type === 'heading' ? <h2>{block.text}</h2> :
          block.type === 'paragraph' ? <p>{block.text}</p> :
          block.type === 'quote' ? <blockquote>{block.text}</blockquote> :
          block.type === 'list' ? (
            block.ordered
              ? <ol>{block.items.map((item) => <li>{item}</li>)}</ol>
              : <ul>{block.items.map((item) => <li>{item}</li>)}</ul>
          ) :
          block.type === 'image' ? (
            <figure>
              <img src={block.src} alt={block.alt} loading="lazy" />
              {block.caption && <figcaption>{block.caption}</figcaption>}
            </figure>
          ) :
          block.type === 'table' ? (
            <div class="article-table-wrap" tabindex="0" role="region" aria-label={`Tabel ${post.title}`}>
              <table>
                <thead><tr>{block.headers.map((header) => <th scope="col">{header}</th>)}</tr></thead>
                <tbody>{block.rows.map((row) => <tr>{row.map((cell) => <td>{cell}</td>)}</tr>)}</tbody>
              </table>
            </div>
          ) : null
        ))}
      </div>
      <a class="text-link" href="/blog/">← Kembali ke blog</a>
    </article>
  </main>
  <SiteFooter />
</BaseLayout>
