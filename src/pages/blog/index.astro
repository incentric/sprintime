---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { posts } from '../../data/posts';

const [featured, ...latestPosts] = posts;
---

<BaseLayout title="Blog Sprintime — Strategi sampai Eksekusi" description="Wawasan praktis untuk membangun strategi, ritme sprint, dan eksekusi tim yang lebih baik.">
  <div class="scroll-progress" aria-hidden="true"><span></span></div>
  <SiteHeader active="blog" />
  <main>
    <section class="blog-hero">
      <div>
        <p class="eyebrow">Sprintime Journal</p>
        <h1>Ide jernih untuk kerja tim yang lebih <span>bermakna.</span></h1>
        <p class="blog-lede">Catatan praktis tentang strategi, OKR, dan ritme kerja agar rencana besar benar-benar sampai ke eksekusi.</p>
      </div>
      <aside class="hero-note" aria-label="Topik blog">
        <p>Untuk tim yang ingin bergerak dengan arah yang sama.</p>
        <div><span>Strategi</span><span>OKR</span><span>Sprint</span></div>
      </aside>
    </section>

    <section class="featured-post" aria-labelledby="featured-title">
      <img src={featured.image} alt="" />
      <div class="featured-content">
        <p class="post-meta"><span>{featured.category}</span>{featured.date} · {featured.readTime}</p>
        <h2 id="featured-title">{featured.title}</h2>
        <p>{featured.excerpt}</p>
        <a class="text-link" href={`/blog/${featured.slug}/`}>Baca artikelnya <span aria-hidden="true">↗</span></a>
      </div>
    </section>

    <section class="latest-posts" aria-labelledby="latest-title">
      <div class="section-heading">
        <div><p class="eyebrow">Artikel terbaru</p><h2 id="latest-title">Kerja yang terarah dimulai dari percakapan yang tepat.</h2></div>
        <a class="text-link" href="#newsletter">Dapatkan pembaruan <span aria-hidden="true">↗</span></a>
      </div>
      <div class="post-grid">
        {latestPosts.map((post) => (
          <article class="post-card">
            <img src={post.image} alt="" loading="lazy" />
            <div>
              <p class="post-meta"><span>{post.category}</span>{post.readTime}</p>
              <h3><a href={`/blog/${post.slug}/`}>{post.title}</a></h3>
              <p>{post.excerpt}</p>
              <a class="card-link" href={`/blog/${post.slug}/`}>Baca selengkapnya <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="newsletter" id="newsletter">
      <div><p class="eyebrow">Tetap terhubung</p><h2>Catatan kecil untuk progres yang konsisten.</h2><p>Dapatkan artikel terbaru Sprintime langsung ke inbox Anda.</p></div>
      <form action="#" method="post"><label class="sr-only" for="email">Alamat email</label><input id="email" name="email" type="email" placeholder="nama@perusahaan.com" required /><button type="submit">Berlangganan</button></form>
    </section>
  </main>
  <footer class="site-footer"><img src="/assets/logo-sprintime-no-tagline.png" alt="Sprintime" width="150" height="35" /><p>© {new Date().getFullYear()} Sprintime. Dari strategi ke eksekusi.</p></footer>
  <script>
    const indicator = document.querySelector<HTMLSpanElement>('.scroll-progress span');
    const update = () => { if (indicator) indicator.style.width = `${Math.min(100, scrollY / Math.max(1, document.documentElement.scrollHeight - innerHeight) * 100)}%`; };
    addEventListener('scroll', update, { passive: true }); update();
  </script>
</BaseLayout>
