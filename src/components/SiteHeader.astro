---
const { active = '' } = Astro.props;
---

<header class="site-header">
  <a class="brand" href="/" aria-label="Sprintime, beranda">
    <img src="/assets/logo-sprintime-no-tagline.png" alt="Sprintime" width="172" height="40" />
  </a>
  <nav class="nav-links" aria-label="Navigasi utama">
    <a href="/#features">Features</a>
    <a href="/#how-it-works">How it Works</a>
    <a class:list={[{ active: active === 'blog' }]} href="/blog/">Blog</a>
    <a href="/#pricing">Pricing</a>
  </nav>
  <div class="header-actions">
    <a class="nav-login" href="#">Login</a>
    <a class="nav-cta" href="/#pricing">Start for free</a>
  </div>
</header>
